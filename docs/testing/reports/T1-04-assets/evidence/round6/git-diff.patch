+        print(f"MIGRATION_PATH_EVIDENCE_WRITE=FAIL: {write_error}", file=sys.stderr)
+
+    machine_redacted = True
+    serialized = json.dumps(evidence, ensure_ascii=False)
+    for raw_value in (
+        str(support.TEST_ROOT),
+        str(support.FORMAL_ROOT),
