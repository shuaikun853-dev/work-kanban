+                "skips": len(skips),
+                "cleanupCases": len(cleanup_results),
+                "evidenceWritten": evidence_written,
+            },
+            ensure_ascii=False,
+        )
+    )
+    if error is not None:
+        return 1
+    return 0 if not failed else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
