+            "existedAfter": formal_after.get("existed"),
+            "identityEvidenceAvailable": formal_unchanged is not None,
+            "identityUnchanged": formal_unchanged,
+            "limitation": (
+                "只读目录身份快照；不构成正式目录内容未被外部进程修改的绝对证明，"
