{
  "name": "workmanager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WorkManager - Windows 本地工作管理软件（绿色便携版）",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && npm run test:work-item-bridge && npm run test:title-cross-contract && npm run check:design-tokens && npm run test:design-tokens",
    "check:design-tokens": "node scripts/quality/check-design-tokens.mjs",
    "test:design-tokens": "node --test scripts/quality/design-tokens.test.mjs",
    "test:title-cross-contract": "node --test scripts/quality/work-item-title-cross-contract.test.mjs",
    "test:work-item-bridge": "node --test scripts/quality/work-item-bridge.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
